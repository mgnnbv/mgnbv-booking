# Копируйте в .env и заполните реальными значениями. Никогда не коммитьте .env.

# asyncpg-драйвер обязателен (SQLAlchemy 2.0 async)
DATABASE_URL=postgresql+asyncpg://mgnbvbooking:mgnbvbooking@localhost:5432/mgnbvbooking

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Ключ шифрования паспортных данных жильцов (Fernet).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# Redis Streams — канал событий для notifications-микросервиса
REDIS_URL=redis://localhost:6379/0
NOTIFICATIONS_STREAM=notifications
