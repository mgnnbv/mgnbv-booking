# Копируйте в .env и заполните реальными значениями. Никогда не коммитьте .env.

# asyncpg-драйвер обязателен (SQLAlchemy 2.0 async)
DATABASE_URL=postgresql+asyncpg://mgnbvbooking:mgnbvbooking@localhost:5432/rental_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email-адреса, которые после подтверждения автоматически получают роль admin.
# Это JSON-список. Укажите [] если автосоздание admin не нужно.
ADMIN_EMAILS=["admin@example.com","owner@example.com"]

# Ключ шифрования паспортных данных жильцов (Fernet).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# RabbitMQ — брокер событий для notifications-микросервиса
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=events

# Redis — зарезервирован под будущее кэширование, событиями больше не занимается
REDIS_URL=redis://localhost:6379/0
